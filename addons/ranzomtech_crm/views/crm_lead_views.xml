<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ranzom_lead_kanban" model="ir.ui.view">
    <field name="name">ranzom.crm.lead.kanban</field>
    <field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <kanban default_group_by="stage_id" class="o_kanban_small_column">
        <field name="name"/>
        <field name="partner_name"/>
        <field name="contact_name"/>
        <field name="expected_revenue"/>
        <field name="probability"/>
        <field name="stage_id"/>
        <field name="ranzom_service"/>
        <field name="ranzom_industry"/>
        <field name="ranzom_next_followup"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <div class="d-flex justify-content-between">
                <strong><field name="name"/></strong>
                <span class="badge text-bg-light"><field name="probability"/>%</span>
              </div>
              <div class="text-muted"><field name="partner_name"/></div>
              <div class="mt-2"><field name="ranzom_service"/></div>
              <div class="mt-2" t-if="record.expected_revenue.raw_value">
                Expected: <field name="expected_revenue" widget="monetary"/>
              </div>
              <div class="mt-2 text-muted" t-if="record.ranzom_next_followup.raw_value">
                Follow-up: <field name="ranzom_next_followup"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_ranzom_lead_list" model="ir.ui.view">
    <field name="name">ranzom.crm.lead.list</field>
    <field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <list default_order="priority desc, create_date desc">
        <field name="name"/>
        <field name="partner_name"/>
        <field name="contact_name"/>
        <field name="phone"/>
        <field name="email_from"/>
        <field name="ranzom_service"/>
        <field name="ranzom_industry"/>
        <field name="stage_id"/>
        <field name="expected_revenue"/>
        <field name="probability"/>
        <field name="ranzom_next_followup"/>
      </list>
    </field>
  </record>

  <record id="view_ranzom_lead_form" model="ir.ui.view">
    <field name="name">ranzom.crm.lead.form</field>
    <field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <form string="RanzomTech Lead">
        <header>
          <button name="action_create_followup" type="object" string="Create Follow-up" class="btn-secondary"/>
          <button name="action_convert_to_client" type="object" string="Convert to Client" class="btn-primary" invisible="ranzom_client_id"/>
          <field name="stage_id" widget="statusbar" options="{'clickable': true}"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_convert_to_client" type="object" class="oe_stat_button" icon="fa-user" invisible="not ranzom_client_id">
              <div class="o_stat_info"><span class="o_stat_text">Client</span></div>
            </button>
          </div>
          <widget name="web_ribbon" text="Client" bg_color="text-bg-success" invisible="not ranzom_client_id"/>
          <div class="oe_title"><h1><field name="name" placeholder="Lead / opportunity name"/></h1></div>
          <group>
            <group string="Lead">
              <field name="partner_name"/>
              <field name="contact_name"/>
              <field name="email_from"/>
              <field name="phone"/>
              <field name="ranzom_source"/>
              <field name="ranzom_service"/>
              <field name="ranzom_industry"/>
            </group>
            <group string="Commercial">
              <field name="expected_revenue"/>
              <field name="ranzom_budget"/>
              <field name="probability"/>
              <field name="user_id"/>
              <field name="team_id"/>
              <field name="ranzom_next_followup"/>
              <field name="ranzom_client_id" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Notes"><field name="description" placeholder="Requirements, context, objections, next step..."/></page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_ranzom_leads" model="ir.actions.act_window">
    <field name="name">Leads &amp; Pipeline</field>
    <field name="res_model">crm.lead</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="view_id" ref="view_ranzom_lead_kanban"/>
    <field name="context">{'default_type': 'lead'}</field>
  </record>
</odoo>
