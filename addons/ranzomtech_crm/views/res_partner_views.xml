<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ranzom_partner_list" model="ir.ui.view">
    <field name="name">ranzom.partner.list</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list string="Clients">
        <field name="name"/>
        <field name="email"/>
        <field name="phone"/>
        <field name="ranzom_client_status"/>
        <field name="ranzom_industry"/>
        <field name="ranzom_quoted"/>
        <field name="ranzom_cash_received"/>
        <field name="ranzom_outstanding"/>
      </list>
    </field>
  </record>
  <record id="view_ranzom_partner_form" model="ir.ui.view">
    <field name="name">ranzom.partner.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <form string="RanzomTech Client">
        <sheet>
          <div class="oe_button_box" name="button_box"/>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group string="Contact">
              <field name="company_type" invisible="1"/>
              <field name="email"/>
              <field name="phone"/>
              <field name="website"/>
            </group>
            <group string="Client Profile">
              <field name="ranzom_is_client"/>
              <field name="ranzom_client_status"/>
              <field name="ranzom_industry"/>
              <field name="ranzom_start_date"/>
            </group>
          </group>
          <group string="Commercial">
            <field name="ranzom_quoted"/>
            <field name="ranzom_cash_received"/>
            <field name="ranzom_outstanding" readonly="1"/>
          </group>
          <group string="Work">
            <field name="ranzom_work_description" placeholder="Services, project scope, notes..."/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_ranzom_clients" model="ir.actions.act_window">
    <field name="name">Clients</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_ranzom_partner_list"/>
    <field name="domain">[('ranzom_is_client', '=', True)]</field>
  </record>
</odoo>
