<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ranzom_followup_list" model="ir.ui.view">
    <field name="name">ranzom.followup.list</field>
    <field name="model">ranzom.followup</field>
    <field name="arch" type="xml">
      <list default_order="due_date asc">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="lead_id"/>
        <field name="due_date"/>
        <field name="followup_type"/>
        <field name="status"/>
        <field name="completed_at"/>
      </list>
    </field>
  </record>
  <record id="view_ranzom_followup_form" model="ir.ui.view">
    <field name="name">ranzom.followup.form</field>
    <field name="model">ranzom.followup</field>
    <field name="arch" type="xml">
      <form string="Follow-up">
        <header>
          <button name="action_mark_done" type="object" string="Mark Done" class="btn-primary" invisible="status == 'done'"/>
          <field name="status" widget="statusbar" statusbar_visible="pending,done,cancelled"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <field name="partner_id"/>
            <field name="lead_id"/>
            <field name="due_date"/>
            <field name="followup_type"/>
            <field name="completed_at" readonly="1"/>
          </group>
          <field name="notes" placeholder="What should happen on this follow-up?"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_ranzom_followups" model="ir.actions.act_window">
    <field name="name">Follow-ups</field>
    <field name="res_model">ranzom.followup</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_ranzom_followup_list"/>
  </record>
</odoo>
